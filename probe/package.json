{
  "name": "shopprobe",
  "private": true,
  "version": "1.0.1",
  "description": "Автоматическая приёмка интернет-витрины: Playwright-проверки с перепроверкой находок",
  "type": "module",
  "bin": {
    "shopprobe": "./src/cli.ts"
  },
  "scripts": {
    "probe": "tsx src/cli.ts",
    "test": "vitest run tests/unit",
    "test:browser": "vitest run tests/browser",
    "lint": "eslint . && tsc --noEmit && prettier --check ."
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "1.62.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "playwright-core": "1.62.1"
  }
}
